# Browser-side, PUBLIC values only (Netlify -> Environment variables, or a local .env). Safe to expose by design.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=<anon (public) key from Supabase -> Project Settings -> API>

# NEVER put these in Netlify/.env/Git. They are Supabase Edge Function secrets (see docs/EMAIL_APPS_SCRIPT_SETUP.md):
#   APPS_SCRIPT_URL, APPS_SCRIPT_SECRET, CRON_SECRET, ALLOWED_ORIGIN (optional), EMAIL_DAILY_CAP (optional)
